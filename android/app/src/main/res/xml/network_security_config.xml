<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9（API 28）起默认禁止明文 HTTP。本演示通过局域网 IP 访问电脑上的
  FastAPI 服务，用的就是 http://，如果没有这个文件，所有请求都会直接失败，
  而且报错信息不直观（CleartextNotPermittedException）。

  演示阶段直接放开全部明文流量，简单可靠；将来换成 HTTPS 后把
  cleartextTrafficPermitted 改成 false 即可。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
